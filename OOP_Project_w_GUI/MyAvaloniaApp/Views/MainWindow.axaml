<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MyAvaloniaApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>


        <StackPanel 
            x:Name="DefaultStackPanel" 
            IsEnabled="True" 
            IsVisible="True" 
            VerticalAlignment="Center"
            Grid.Column="1">
            
            <TextBox Text="{Binding Greeting}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            />

            <TextBlock 
                xml:space="preserve">
            </TextBlock>

            <TextBlock
                x:Name="message"
                Margin="5"
                FontSize="20"
                HorizontalAlignment="Center">
                Press Button to Enter Editor
            </TextBlock>
        
            <TextBlock 
                xml:space="preserve">
            </TextBlock>

            <Button
                x:Name="StartButton"
                Tag="{Binding #ActivitiesPanel}"
                Click="openPanel"
                Background="#27325F"
                Foreground="White"
                FontSize="20"
                Margin="2"
                Padding="10,5"
                Content="Enter Editor"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
            />
        </StackPanel>

        <StackPanel
            x:Name="ActivitiesPanel" IsEnabled="False" IsVisible="False">
            <Grid x:Name="ActivitiesGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="ViewActivitiesPanel"
                    HorizontalAlignment="Center"
                    Grid.Column="1">

                    <TextBlock
                        x:Name="viewActivitiesHeader"
                        Margin="5"
                        FontSize="20"
                        HorizontalAlignment="Center">
                        Current Activities:
                    </TextBlock>

                    <DataGrid 
                        x:Name="ActivitiesList"
                        ItemsSource="{Binding AllActivities}" 
                        AutoGenerateColumns="false"
                        Height="450"
                        Background="#81B7DC"
                        IsReadOnly="True"
                        Margin="10,10,10,5"
                        >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DateStartTime" Binding="{Binding DateStartTime}" Width="30*"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="30*"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="15*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="25*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
                <Grid x:Name="ActivitiesSideControlsGrid"
                    Grid.Column="0"
                    >      
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                    </Grid.RowDefinitions>
                
                    <StackPanel
                        x:Name="ActivitiesPanelMenu"
                        HorizontalAlignment="Center"
                        Grid.Row="0"
                        IsEnabled="True"
                        IsVisible="True"
                        >

                        <Grid x:Name="ActivitiesSideControlButtonsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="AddActivitiesButton"
                                Tag="{Binding #AddActivitiesPanel}"
                                Click="openActivitySidePanel"
                                Background="#27325F"
                                Foreground="White"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Add Activities"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Grid.Column="0"
                            />

                            <Button
                                x:Name="EditActivitiesButton"
                                Tag="{Binding #EditActivitiesPanel}"
                                Click="openActivitySidePanel"
                                Background="#27325F"
                                Foreground="White"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Edit Activities"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                            />

                            <Button
                                x:Name="SearchActivitiesButton"
                                Tag="{Binding #SearchActivitiesPanel}"
                                Click="openActivitySidePanel"
                                Background="#27325F"
                                Foreground="White"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Search Activities"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Grid.Column="2"
                            />

                        </Grid>

                    </StackPanel>

                    <StackPanel
                        x:Name="AddActivitiesPanel"
                        HorizontalAlignment="Center"
                        Grid.Row="1"
                        IsEnabled="False"
                        IsVisible="False"
                        >

                        <TextBlock
                            x:Name="addActivitiesHeader"
                            Margin="5"
                            FontSize="20"
                            HorizontalAlignment="Center">
                            Add Activity:
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20">
                            <TextBlock
                                x:Name="activityTypeHeader"
                                FontSize="20"
                                VerticalAlignment="Center">
                                Activity Type:
                            </TextBlock>

                            <Button 
                                x:Name="FitnessActivityTypeButton"
                                Tag="{Binding #EntertainmentActivityTypeButton}"
                                Click="selectFitness"
                                Background="#27325F"
                                Foreground="White"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Fitness"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            />

                            <Button 
                                x:Name="EntertainmentActivityTypeButton"
                                Tag="{Binding #FitnessActivityTypeButton}"
                                Click="selectEntertainment"
                                Background="#27325F"
                                Foreground="White"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Entertainment"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            />

                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5" HorizontalAlignment="Center">
                            <!-- Date Selection Component -->
                            <CalendarDatePicker 
                                x:Name="ActivityDateInput"
                                Tag="DATE INPUT REQUIRED"
                                Watermark="Activity Start Date/Time"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd-MM-yyyy"
                            />

                            <!-- Time Selection Component -->
                            <TimePicker 
                                x:Name="ActivityTimeInput" 
                                ClockIdentifier="24HourClock" 
                                MinuteIncrement="1"
                            />
                        </StackPanel>

                        <TextBox 
                            x:Name="ActivityTitleInput" 
                            Tag="TITLE INPUT REQUIRED"
                            Width="200" 
                            Watermark="Write activity title here"
                        />

                        <!-- Text Changing value links to function that catches and reverts any non int inputs -->
                        <TextBox 
                            x:Name="ActivityCostInput" 
                            Tag="COST INPUT REQUIRED"
                            Width="200" 
                            Watermark="Write activity cost here"
                            TextChanging="catchNonCostInput"
                        />


                        <StackPanel 
                            x:Name="SubmitEntertainmentActivityPanel"  
                            IsVisible="False" 
                            IsEnabled="False">


                            <TextBox 
                                x:Name="ActivityMinParticipantsInput" 
                                Tag="MINIMUM PARTICIPANT COUNT REQUIRED"
                                TextChanging="catchNonIntInput"
                                Width="200" 
                                Watermark="Write activity minimum participants here"
                            />

                            <Button 
                                x:Name="EntertainmentActivitySubmitButton"
                                Click="addEntertainmentActivity"
                                Background="Blue"
                                Foreground="Yellow"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Add Activity"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            />
                        </StackPanel>


                        <StackPanel 
                            x:Name="SubmitFitnessActivityPanel"  
                            IsVisible="False" 
                            IsEnabled="False">


                            <TextBox 
                                x:Name="ActivityLocationInput"
                                Tag="LOCATION INPUT REQUIRED"
                                Width="200" 
                                Watermark="Write activity location here"
                            />

                            <Button 
                                x:Name="FitnessActivitySubmitButton"
                                Click="addFitnessActivity"
                                Background="Blue"
                                Foreground="Yellow"
                                FontSize="20"
                                Margin="2"
                                Padding="10,5"
                                Content="Add Activity"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel
                        x:Name="EditActivitiesPanel"
                        HorizontalAlignment="Center"
                        Grid.Row="1"
                        IsEnabled="False"
                        IsVisible="False"
                        >

                        <TextBlock
                            x:Name="editActivitiesHeader"
                            Margin="5"
                            FontSize="20"
                            HorizontalAlignment="Center">
                            Edit Activities:
                        </TextBlock>

                    </StackPanel>

                    <StackPanel
                        x:Name="SearchActivitiesPanel"
                        HorizontalAlignment="Center"
                        Grid.Row="1"
                        IsEnabled="False"
                        IsVisible="False"
                        >

                        <TextBlock
                            x:Name="searchActivitiesHeader"
                            Margin="5"
                            FontSize="20"
                            HorizontalAlignment="Center">
                            Search Activities:
                        </TextBlock>    
                    </StackPanel>

                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
    
</Window>
